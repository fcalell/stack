{
	"name": "@fcalell/plugin-vite",
	"version": "0.1.0",
	"description": "Framework-agnostic Vite lifecycle plugin for @fcalell/stack, with Tailwind v4 and the providers and schema virtual modules.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/vite"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/vite#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./dist/node/index.js"
		},
		"./preset": {
			"types": "./dist/node/preset.d.ts",
			"default": "./dist/node/preset.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"test": "node --test 'src/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-api": "workspace:^",
		"vite": "^7.0.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"typescript": "^5.9.3"
	}
}
