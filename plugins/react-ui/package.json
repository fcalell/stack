{
	"name": "@fcalell/plugin-react-ui",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node/fonts": {
			"types": "./dist/node/fonts.d.ts",
			"default": "./dist/node/fonts.js"
		},
		"./node/mode": {
			"types": "./dist/node/mode.d.ts",
			"default": "./dist/node/mode.js"
		},
		"./globals.css": "./src/ui/globals.css",
		"./lib/words": "./src/ui/lib/words.tsx",
		"./showcase": "./src/ui/showcase/index.tsx"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"tsconfig.json",
		"tsconfig.build.json"
	],
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"test": "node --test 'test/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"peerDependencies": {
		"react": "^19.3"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:*",
		"@fcalell/plugin-auth": "workspace:*",
		"@fcalell/plugin-react": "workspace:*",
		"@fcalell/plugin-vite": "workspace:*",
		"@fcalell/ui-core": "workspace:*",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"lucide-react": "^1.48.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:*",
		"@types/node": "^25.5.0",
		"@types/react": "^19.3.0",
		"react": "^19.3.0",
		"typescript": "^5.9.3",
		"vite": "^7.0.4"
	}
}
