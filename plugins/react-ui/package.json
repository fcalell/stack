{
	"name": "@fcalell/plugin-react-ui",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node/fonts": {
			"types": "./dist/node/fonts.d.ts",
			"default": "./dist/node/fonts.js"
		},
		"./node/mode": {
			"types": "./dist/node/mode.d.ts",
			"default": "./dist/node/mode.js"
		},
		"./density": {
			"types": "./dist/density.d.ts",
			"default": "./dist/density.js"
		},
		"./globals.css": "./src/ui/globals.css",
		"./components/*": "./src/ui/components/*/index.tsx",
		"./lib/words": "./src/ui/lib/words.tsx",
		"./lib/*": "./src/ui/lib/*.ts",
		"./showcase": "./src/ui/showcase/index.tsx",
		"./showcase/foundations": "./src/ui/showcase/foundations.tsx",
		"./showcase/layout": "./src/ui/showcase/layout.tsx"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"tsconfig.json",
		"tsconfig.build.json"
	],
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"test": "node --test 'test/**/*.test.ts'",
		"clear": "rm -rf dist node_modules .turbo",
		"design": "tsx scripts/design.ts",
		"verify": "tsx scripts/verify.ts"
	},
	"peerDependencies": {
		"react": "^19.3"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fcalell/cli": "workspace:*",
		"@fcalell/plugin-auth": "workspace:*",
		"@fcalell/plugin-react": "workspace:*",
		"@fcalell/plugin-vite": "workspace:*",
		"@fcalell/ui-core": "workspace:*",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"diff": "^8.0.2",
		"lucide": "^1.49.0",
		"lucide-react": "^1.49.0",
		"marked": "^18.0.7",
		"qrcode-generator": "^2.0.4",
		"tailwindcss": "^4.3.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:*",
		"@tailwindcss/cli": "^4.3.3",
		"@types/node": "^25.5.0",
		"@types/react": "^19.3.0",
		"react": "^19.3.0",
		"ts-morph": "^28.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"vite": "^7.0.4"
	}
}
