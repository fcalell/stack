{
	"name": "@fcalell/plugin-solid",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./codegen": {
			"types": "./dist/node/codegen.d.ts",
			"default": "./dist/node/codegen.js"
		},
		"./node/vite-routes": {
			"types": "./dist/node/vite-routes.d.ts",
			"default": "./dist/node/vite-routes.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"README.md"
	],
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:*",
		"@fcalell/plugin-vite": "workspace:*",
		"fast-glob": "^3.3.3",
		"vite-plugin-solid": "^2.11.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:*",
		"typescript": "^5.9.3",
		"vite": "^7.0.4"
	}
}
