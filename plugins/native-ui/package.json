{
	"name": "@fcalell/plugin-native-ui",
	"version": "0.1.0",
	"description": "The phone half of the stack design system: the @fcalell/ui-core roster in React Native, Expo and uniwind.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/native-ui"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/native-ui#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./app": "./src/ui/app/index.tsx",
		"./components/action-bar": "./src/ui/components/action-bar/index.tsx",
		"./components/banner": "./src/ui/components/banner/index.tsx",
		"./components/bar-chart": "./src/ui/components/bar-chart/index.tsx",
		"./components/button": "./src/ui/components/button/index.tsx",
		"./components/card": "./src/ui/components/card/index.tsx",
		"./components/code": "./src/ui/components/code/index.tsx",
		"./components/columns": "./src/ui/components/columns/index.tsx",
		"./components/diff": "./src/ui/components/diff/index.tsx",
