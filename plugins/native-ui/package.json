		"./components/prose": "./src/ui/components/prose/index.tsx",
		"./components/qr-code": "./src/ui/components/qr-code/index.tsx",
		"./components/rules": "./src/ui/components/rules/index.tsx",
		"./components/section": "./src/ui/components/section/index.tsx",
		"./components/sheet": "./src/ui/components/sheet/index.tsx",
		"./components/shell": "./src/ui/components/shell/index.tsx",
		"./components/slider": "./src/ui/components/slider/index.tsx",
		"./components/stages": "./src/ui/components/stages/index.tsx",
		"./components/stats": "./src/ui/components/stats/index.tsx",
		"./components/switch": "./src/ui/components/switch/index.tsx",
		"./components/table": "./src/ui/components/table/index.tsx",
		"./components/text": "./src/ui/components/text/index.tsx",
		"./components/thread": "./src/ui/components/thread/index.tsx",
		"./components/toast": "./src/ui/components/toast/index.tsx",
		"./components/toolbar": "./src/ui/components/toolbar/index.tsx",
		"./lib/age": "./src/ui/lib/age.ts",
		"./lib/confirm": "./src/ui/lib/confirm.ts",
		"./lib/net": "./src/ui/lib/net.ts",
		"./lib/not-found": "./src/ui/lib/not-found.tsx",
		"./lib/room": "./src/ui/lib/room.tsx",
		"./lib/theme": "./src/ui/lib/theme.ts",
		"./lib/toast": "./src/ui/lib/toast.ts",
		"./lib/words": "./src/ui/lib/words.tsx"
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"tsconfig.json",
		"tsconfig.build.json",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf dist node_modules .turbo",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@better-auth/expo": "1.7.7",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@orpc/tanstack-query": "^1.14.4",
		"@tanstack/react-query": "^5.100.2",
		"lucide-react-native": "^1.49.0",
		"react": "^19.2.0",
		"react-native": "^0.85.0",
		"react-native-gesture-handler": "^3.0.0",
		"react-native-keyboard-controller": "^1.18.0",
		"react-native-reanimated": "^4.4.1",
		"react-native-safe-area-context": "^5.6.0",
		"uniwind": "^1.12.1",
		"expo-router": "~56.2.8",
		"react-native-svg": "^15.15.4",
		"expo-clipboard": "~56.0.3",
