		"./components/gate": "./src/ui/components/gate/index.tsx",
		"./components/image": "./src/ui/components/image/index.tsx",
		"./components/input": "./src/ui/components/input/index.tsx",
		"./components/pane": "./src/ui/components/pane/index.tsx",
