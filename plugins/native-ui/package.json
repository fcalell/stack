		"@fcalell/plugin-api": "workspace:^",
		"@fcalell/plugin-auth": "workspace:^",
		"@fcalell/plugin-expo": "workspace:^",
		"@fcalell/ui-core": "workspace:^",
		"class-variance-authority": "^0.7.1",
		"lucide": "^1.49.0",
		"zod": "^4.3.6",
		"diff": "^8.0.2",
		"marked": "^18.0.7"
	},
	"devDependencies": {
		"@better-auth/expo": "1.7.7",
		"@fcalell/typescript-config": "workspace:^",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@orpc/tanstack-query": "^1.14.4",
		"@tailwindcss/cli": "^4.1.7",
		"@tanstack/react-query": "^5.104.0",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.16",
		"lucide-react-native": "^1.49.0",
		"react": "19.2.3",
		"react-native": "^0.85.3",
		"react-native-gesture-handler": "^3.0.0",
		"react-native-keyboard-controller": "^1.18.0",
		"react-native-reanimated": "^4.4.1",
		"react-native-safe-area-context": "^5.6.0",
		"react-native-worklets": "^0.9.0",
		"tailwindcss": "^4.1.7",
		"typescript": "^5.9.3",
		"uniwind": "^1.12.1",
		"expo-router": "~56.2.8",
		"react-native-svg": "^15.15.4",
		"expo-clipboard": "~56.0.3",
		"expo-file-system": "~56.0.7",
		"expo-sharing": "~56.0.16",
		"expo-document-picker": "~56.0.4",
		"expo-image-picker": "~56.0.16",
