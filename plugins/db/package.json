{
	"name": "@fcalell/plugin-db",
	"version": "0.1.0",
	"description": "Database plugin for @fcalell/stack: Drizzle ORM over Cloudflare D1 or a SQLite file, with schema tooling and migrations.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/db"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/db#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/worker/index.d.ts",
			"default": "./dist/worker/index.js"
		},
		"./runtime/sqlite": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./orm": {
			"types": "./dist/orm.d.ts",
			"default": "./dist/orm.js"
		},
		"./d1": {
			"types": "./dist/d1/client.d.ts",
			"default": "./dist/d1/client.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite/client.d.ts",
			"default": "./dist/sqlite/client.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "node ../../scripts/prepare.ts",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf dist node_modules .turbo",
		"test": "node --test 'src/**/*.test.ts'"
	},
	"peerDependencies": {
		"drizzle-kit": "^0.31.10"
	},
	"peerDependenciesMeta": {
		"drizzle-kit": {
			"optional": true
		}
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-api": "workspace:^",
		"@fcalell/plugin-cloudflare": "workspace:^",
		"@fcalell/plugin-node": "workspace:^",
		"@fcalell/plugin-screens": "workspace:^",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^25.5.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.9.3"
	}
}
