{
	"name": "@fcalell/plugin-react",
	"version": "0.1.0",
	"description": "React framework plugin for @fcalell/stack: React on Vite with the React Compiler, TanStack Router file routes and the HTML shell.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/react"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/react#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./codegen": {
			"types": "./dist/node/codegen.d.ts",
			"default": "./dist/node/codegen.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf dist node_modules .turbo",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-vite": "workspace:^",
		"@tanstack/router-generator": "^1.167.39",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@types/node": "^25.5.0",
		"typescript": "^5.9.3"
	}
}
