{
	"name": "@fcalell/plugin-screens",
	"version": "0.1.0",
	"description": "The screens workbench for @fcalell/stack web apps: every route in each query state, from typed fixtures, with no backend.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/screens"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/screens#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"default": "./dist/node/index.js"
		},
		"./vite": {
			"types": "./dist/node/vite-plugin.d.ts",
			"default": "./dist/node/vite-plugin.js"
		},
		"./storybook": {
			"types": "./dist/node/storybook.d.ts",
			"default": "./dist/node/storybook.js"
		},
		"./channels": "./src/ui/channels.ts",
		"./fixtures": "./src/ui/fixtures.ts",
		"./floors": "./src/ui/floors.ts",
		"./msw": "./src/ui/msw.ts",
		"./preview": "./src/ui/preview.tsx",
		"./stories": "./src/ui/stories.tsx"
	},
	"files": [
		"dist",
		"src",
		"guide",
		"README.md",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"test": "node --test 'src/**/*.test.ts'",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf dist node_modules .turbo",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/react-vite": "^10.6.1",
		"@tanstack/react-router": "^1.170.40",
		"@vitest/browser-playwright": "^5.0.3",
		"msw": "^2.15.0",
		"msw-storybook-addon": "^3.0.3",
		"playwright": "^1.63.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"storybook": "^10.6.1",
		"vitest": "^5.0.3"
	},
	"peerDependenciesMeta": {
		"@storybook/addon-a11y": {
			"optional": true
		},
		"@storybook/addon-vitest": {
			"optional": true
		},
		"@storybook/react-vite": {
			"optional": true
		},
		"@tanstack/react-router": {
			"optional": true
		},
		"@vitest/browser-playwright": {
			"optional": true
		},
		"msw": {
			"optional": true
		},
		"msw-storybook-addon": {
			"optional": true
		},
		"playwright": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"storybook": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-api": "workspace:^",
		"@fcalell/plugin-react": "workspace:^",
		"@fcalell/plugin-vite": "workspace:^",
		"@fcalell/ui-core": "workspace:^",
		"@orpc/client": "^1.14.4",
		"@orpc/server": "^1.14.4",
		"@orpc/standard-server-fetch": "^1.14.4",
		"ws": "^8.21.1"
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/react-vite": "^10.6.1",
		"@tanstack/react-router": "^1.170.40",
		"@types/node": "^25.5.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser-playwright": "^5.0.3",
		"msw": "^2.15.0",
		"msw-storybook-addon": "^3.0.3",
		"playwright": "^1.63.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"storybook": "^10.6.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^5.0.3"
	}
}
