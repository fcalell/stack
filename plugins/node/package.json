{
	"name": "@fcalell/plugin-node",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server/index.ts",
		"./ws": "./src/ws/index.ts",
		"./client": "./src/client/index.ts"
	},
	"license": "MIT",
	"scripts": {
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"test": "vitest run",
		"clear": "rm -rf node_modules .turbo"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:*",
		"@fcalell/plugin-api": "workspace:*",
		"@fcalell/plugin-vite": "workspace:*",
		"@hono/node-server": "^2.0.9",
		"hono": "^4.12.23",
		"ws": "^8.21.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@fcalell/typescript-config": "workspace:*",
		"@types/node": "^25.5.0",
		"@types/ws": "^8.18.1",
		"typescript": "^5.9.3"
	}
}
