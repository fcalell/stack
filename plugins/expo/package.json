{
	"name": "@fcalell/plugin-expo",
	"version": "0.1.0",
	"description": "The Expo/React Native target for @fcalell/stack: Metro config, Expo app config, the expo-router entry and EAS commands.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "plugins/expo"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/plugins/expo#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./version-gate": {
			"types": "./dist/worker/version-gate.d.ts",
			"default": "./dist/worker/version-gate.js"
		}
	},
	"files": [
		"dist",
		"src",
		"templates",
		"guide",
		"README.md",
		"tsconfig.json",
		"tsconfig.build.json",
		"LICENSE",
		"!src/**/*.test.ts",
		"!src/**/__fixtures__",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf dist node_modules .turbo",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@fcalell/cli": "workspace:^",
		"@fcalell/plugin-api": "workspace:^",
		"@fcalell/plugin-cloudflare": "workspace:^",
		"expo": "~56.0.8",
		"hono": "^4.12.23",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"expo-application": ">=56.0.0",
		"react-native": ">=0.85.0"
	},
	"peerDependenciesMeta": {
		"expo-application": {
			"optional": true
		},
		"react-native": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fcalell/typescript-config": "workspace:^",
		"@types/node": "^25.5.0",
		"expo-application": "~56.0.0",
		"react-native": "0.85.3",
		"typescript": "^5.9.3"
	}
}
