{
	"name": "@fcalell/stack",
	"private": true,
	"scripts": {
		"lint": "biome check --write --unsafe",
		"check-types": "turbo run check-types",
		"check": "turbo run build check-types test && pnpm lint",
		"showcase": "turbo run build --filter=showcase... && pnpm --filter showcase dev",
		"clear": "pnpm -r --if-present run clear && rm -rf node_modules .turbo"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"turbo": "^2.8.17"
	},
	"packageManager": "pnpm@11.28.3",
	"engines": {
		"node": ">=22.13"
	}
}
