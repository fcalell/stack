{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".stack/**"]
		},
		"generate": {
			"dependsOn": ["^build"],
			"outputs": [".stack/**"]
		},
		"dev": {
			"interactive": true,
			"cache": false
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^build", "build"]
		},
		"test": {
			"dependsOn": ["^build"]
		}
	}
}
