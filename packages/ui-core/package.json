{
	"name": "@fcalell/ui-core",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./src/*.ts"
	},
	"exports": {
		"./tokens": "./src/tokens.ts",
		"./schema": "./src/schema.ts",
		"./derive": "./src/derive.ts",
		"./emit": "./src/emit.ts",
		"./cn": "./src/cn.ts",
		"./variants": "./src/variants.ts",
		"./descriptors": "./src/descriptors.ts",
		"./harness": "./src/harness.ts",
		"./gate": "./src/gate.ts"
	},
	"files": [
		"src",
		"scripts",
		"README.md"
	],
	"license": "MIT",
	"scripts": {
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"verify": "tsx scripts/verify.ts",
		"clear": "rm -rf node_modules .turbo"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0",
		"ts-morph": "^28.0.0"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@fcalell/cli": "workspace:*",
		"@fcalell/typescript-config": "workspace:*",
		"@tailwindcss/cli": "^4.1.7",
		"@types/node": "^25.5.0",
		"tailwindcss": "^4.1.7",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	}
}
