{
	"name": "@fcalell/ui-core",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./src/*.ts"
	},
	"exports": {
		"./tokens": {
			"types": "./dist/tokens.d.ts",
			"default": "./dist/tokens.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./derive": {
			"types": "./dist/derive.d.ts",
			"default": "./dist/derive.js"
		},
		"./emit": {
			"types": "./dist/emit.d.ts",
			"default": "./dist/emit.js"
		},
		"./commit": {
			"types": "./dist/commit.d.ts",
			"default": "./dist/commit.js"
		},
		"./canvas": {
			"types": "./dist/canvas.d.ts",
			"default": "./dist/canvas.js"
		},
		"./chart": {
			"types": "./dist/chart.d.ts",
			"default": "./dist/chart.js"
		},
		"./clock": {
			"types": "./dist/clock.d.ts",
			"default": "./dist/clock.js"
		},
		"./reason": {
			"types": "./dist/reason.d.ts",
			"default": "./dist/reason.js"
		},
		"./format": {
			"types": "./dist/format.d.ts",
			"default": "./dist/format.js"
		},
		"./file": {
			"types": "./dist/file.d.ts",
			"default": "./dist/file.js"
		},
		"./cn": {
			"types": "./dist/cn.d.ts",
			"default": "./dist/cn.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		},
		"./descriptors": {
			"types": "./dist/descriptors.d.ts",
			"default": "./dist/descriptors.js"
		},
		"./roster": {
			"types": "./dist/roster.d.ts",
			"default": "./dist/roster.js"
		},
		"./route": {
			"types": "./dist/route.d.ts",
			"default": "./dist/route.js"
		},
		"./harness": {
			"types": "./dist/harness.d.ts",
			"default": "./dist/harness.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"default": "./dist/manifest.js"
		},
		"./leave": {
			"types": "./dist/leave.d.ts",
			"default": "./dist/leave.js"
		},
		"./list-state": {
			"types": "./dist/list-state.d.ts",
			"default": "./dist/list-state.js"
		},
		"./streaming": {
			"types": "./dist/streaming.d.ts",
			"default": "./dist/streaming.js"
		},
		"./rules": {
			"types": "./dist/rules.d.ts",
			"default": "./dist/rules.js"
		}
	},
	"files": [
		"dist",
		"src",
		"scripts",
		"guide",
		"README.md",
		"DESIGN.md",
		"tsconfig.json",
		"tsconfig.build.json"
	],
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"test": "node --test 'test/**/*.test.ts'",
		"verify": "tsx scripts/verify.ts",
		"clear": "rm -rf dist node_modules .turbo",
		"design-md": "tsx scripts/design-md.ts && design.md lint DESIGN.md"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide": "^1.49.0",
		"tailwind-merge": "^3.5.0"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@fcalell/cli": "workspace:*",
		"@fcalell/typescript-config": "workspace:*",
		"@google/design.md": "^0.4.0",
		"@tailwindcss/cli": "^4.1.7",
		"@types/node": "^25.5.0",
		"tailwindcss": "^4.1.7",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	}
}
