{
	"name": "@fcalell/ui-core",
	"version": "0.0.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./tokens": {
			"types": "./dist/tokens.d.ts",
			"default": "./dist/tokens.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./derive": {
			"types": "./dist/derive.d.ts",
			"default": "./dist/derive.js"
		},
		"./emit": {
			"types": "./dist/emit.d.ts",
			"default": "./dist/emit.js"
		},
		"./cn": {
			"types": "./dist/cn.d.ts",
			"default": "./dist/cn.js"
		},
		"./variants": {
			"types": "./dist/variants.d.ts",
			"default": "./dist/variants.js"
		},
		"./descriptors": {
			"types": "./dist/descriptors.d.ts",
			"default": "./dist/descriptors.js"
		},
		"./harness": {
			"types": "./dist/harness.d.ts",
			"default": "./dist/harness.js"
		},
		"./gate": {
			"types": "./dist/gate.d.ts",
			"default": "./dist/gate.js"
		}
	},
	"files": [
		"dist",
		"src",
		"scripts",
		"README.md"
	],
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "pnpm build",
		"check-types": "tsc --noEmit --pretty",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"verify": "tsx scripts/verify.ts",
		"clear": "rm -rf dist node_modules .turbo"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0",
		"ts-morph": "^28.0.0"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@fcalell/cli": "workspace:*",
		"@fcalell/typescript-config": "workspace:*",
		"@tailwindcss/cli": "^4.1.7",
		"@types/node": "^25.5.0",
		"tailwindcss": "^4.1.7",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	}
}
