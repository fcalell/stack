{
	"$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*",
			"!**/*.d.ts",
			"!**/dist",
			"!**/build",
			"!**/node_modules",
			"!**/.turbo",
			"!**/.wrangler",
			"!**/.output",
			"!**/.stack",
			"!**/.claude/worktrees",
			"!**/storybook-static",
			"!**/coverage",
			"!**/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"useValidAriaRole": {
					"level": "error",
					"options": { "ignoreNonDom": true }
				}
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		}
	}
}
