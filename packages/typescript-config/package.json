{
	"name": "@fcalell/typescript-config",
	"version": "0.1.0",
	"description": "Shared TypeScript configuration presets for the @fcalell/stack framework.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fcalell/stack.git",
		"directory": "packages/typescript-config"
	},
	"homepage": "https://github.com/fcalell/stack/tree/master/packages/typescript-config#readme",
