  "html": null,
  "providers": null,
  "viteConfig": null,
  "worker": "import * as schema from "../src/schema";
import * as routes from "../src/worker/routes/index.ts";
import createWorker from "@fcalell/plugin-api/runtime";
import authRuntime from "@fcalell/plugin-auth/runtime";
import dbRuntime from "@fcalell/plugin-db/runtime";
import authCallbacks from "../src/worker/plugins/auth";
const worker = createWorker({ prefix: "/rpc", cors: ["https://example.com", "https://app.example.com"] }).use(authRuntime({ emailOtp: true, secretVar: "AUTH_SECRET", appUrlVar: "APP_URL", rateLimiter: { ip: { binding: "RATE_LIMITER_IP" }, email: { binding: "RATE_LIMITER_EMAIL" } }, trustedOrigins: ["https://example.com", "https://app.example.com"], callbacks: authCallbacks })).use(dbRuntime({ binding: "DB_MAIN", schema: schema })).handler(routes);
export type AppRouter = typeof worker._router;
export default worker;
",
  "wrangler": "name = "test-app"
compatibility_date = "2025-01-01"
main = "worker.ts"
compatibility_flags = [ "nodejs_compat" ]

[vars]
AUTH_SECRET = ""
APP_URL = ""

[[d1_databases]]
binding = "DB_MAIN"
database_id = "abc-123"
database_name = "abc-123"
migrations_dir = "./src/migrations"

[[unsafe.bindings]]
name = "RATE_LIMITER_EMAIL"
type = "ratelimit"
limit = 3
period = 60

[[unsafe.bindings]]
name = "RATE_LIMITER_IP"
type = "ratelimit"
limit = 100
period = 60

[[unsafe.bindings]]
name = "RATE_LIMITER_RPC"
type = "ratelimit"
limit = 1000
period = 60
",
}
