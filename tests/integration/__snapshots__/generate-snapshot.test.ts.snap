// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generate pipeline snapshot > api-only: worker without frontend 1`] = `
{
  "appCss": null,
  "entry": null,
  "files": [
    {
      "content": "import * as schema from "../src/schema";
import createWorker from "@fcalell/plugin-api/runtime";
import type { AppBuilder } from "@fcalell/plugin-api/runtime";
import dbRuntime from "@fcalell/plugin-db/runtime";
import { createProcedure } from "@fcalell/plugin-api/procedure";
const __chain = createWorker({ prefix: "/rpc", cors: ["https://example.com"] }).use(dbRuntime({ binding: "DB_MAIN", schema: schema }));

// Type-only: \`__chain\` mirrors the runtime plugin composition in
// .stack/worker.ts so \`WorkerContext\` matches the real request context
// without re-deriving each runtime factory's generics by hand. Never
// exported or called further — only its type is used below.
type ContextOf<B> = B extends AppBuilder<infer C> ? C : never;
type WorkerContext = ContextOf<typeof __chain>;
type RbacStatements = Record<never, never>;
type Entity = string;

export const procedure = createProcedure<WorkerContext, RbacStatements, Entity>();
",
      "path": ".stack/procedure.ts",
    },
    {
      "content": "// Generated by @fcalell/plugin-api — do not edit.
export * from "./users.ts";
",
      "path": "src/worker/routes/index.ts",
    },
  ],
  "html": null,
  "providers": null,
  "viteConfig": null,
  "worker": "import * as schema from "../src/schema";
import * as routes from "../src/worker/routes/index.ts";
import createWorker from "@fcalell/plugin-api/runtime";
import dbRuntime from "@fcalell/plugin-db/runtime";
const worker = createWorker({ prefix: "/rpc", cors: ["https://example.com"] }).use(dbRuntime({ binding: "DB_MAIN", schema: schema })).handler(routes);
export type AppRouter = typeof worker._router;
export default worker;
",
  "wrangler": "name = "test-app"
compatibility_date = "2025-01-01"
main = "worker.ts"

[[d1_databases]]
binding = "DB_MAIN"
database_id = "abc-123"
database_name = "abc-123"
migrations_dir = "./src/migrations"

[[unsafe.bindings]]
name = "RATE_LIMITER_RPC"
type = "ratelimit"
limit = 1000
period = 60
",
}
`;

exports[`generate pipeline snapshot > auth with localhost in app.origins: sameSite=none end-to-end 1`] = `
{
  "appCss": null,
  "entry": null,
  "files": [
    {
      "content": "import * as schema from "../src/schema";
import createWorker from "@fcalell/plugin-api/runtime";
import type { AppBuilder } from "@fcalell/plugin-api/runtime";
import authRuntime from "@fcalell/plugin-auth/runtime";
import dbRuntime from "@fcalell/plugin-db/runtime";
import { createProcedure } from "@fcalell/plugin-api/procedure";
const __chain = createWorker({ prefix: "/rpc", cors: ["https://example.com", "http://localhost:5173"] }).use(authRuntime({ emailOtp: true, secretVar: "AUTH_SECRET", appUrlVar: "APP_URL", rateLimiter: { ip: { binding: "RATE_LIMITER_IP" }, email: { binding: "RATE_LIMITER_EMAIL" } }, trustedOrigins: ["https://example.com", "http://localhost:5173"], sameSite: "none" })).use(dbRuntime({ binding: "DB_MAIN", schema: schema }));

// Type-only: \`__chain\` mirrors the runtime plugin composition in
// .stack/worker.ts so \`WorkerContext\` matches the real request context
// without re-deriving each runtime factory's generics by hand. Never
// exported or called further — only its type is used below.
type ContextOf<B> = B extends AppBuilder<infer C> ? C : never;
type WorkerContext = ContextOf<typeof __chain>;
type RbacStatements = Record<never, never>;
type Entity = "account" | "session" | "user" | "verification";

export const procedure = createProcedure<WorkerContext, RbacStatements, Entity>();
",
      "path": ".stack/procedure.ts",
    },
    {
      "content": "// Generated by @fcalell/plugin-api — do not edit.
export * from "./users.ts";
",
      "path": "src/worker/routes/index.ts",
    },
  ],
  "html": null,
  "providers": null,
  "viteConfig": null,
  "worker": "import * as schema from "../src/schema";
import * as routes from "../src/worker/routes/index.ts";
import createWorker from "@fcalell/plugin-api/runtime";
import authRuntime from "@fcalell/plugin-auth/runtime";
import dbRuntime from "@fcalell/plugin-db/runtime";
import authCallbacks from "../src/worker/plugins/auth";
const worker = createWorker({ prefix: "/rpc", cors: ["https://example.com", "http://localhost:5173"] }).use(authRuntime({ emailOtp: true, secretVar: "AUTH_SECRET", appUrlVar: "APP_URL", rateLimiter: { ip: { binding: "RATE_LIMITER_IP" }, email: { binding: "RATE_LIMITER_EMAIL" } }, trustedOrigins: ["https://example.com", "http://localhost:5173"], sameSite: "none", callbacks: authCallbacks })).use(dbRuntime({ binding: "DB_MAIN", schema: schema })).handler(routes);
export type AppRouter = typeof worker._router;
export default worker;
",
  "wrangler": "name = "test-app"
compatibility_date = "2025-01-01"
main = "worker.ts"
compatibility_flags = [ "nodejs_compat" ]

[vars]
AUTH_SECRET = ""
APP_URL = ""

[[d1_databases]]
binding = "DB_MAIN"
database_id = "abc-123"
database_name = "abc-123"
migrations_dir = "./src/migrations"

[[unsafe.bindings]]
name = "RATE_LIMITER_EMAIL"
type = "ratelimit"
limit = 3
period = 60

[[unsafe.bindings]]
name = "RATE_LIMITER_IP"
type = "ratelimit"
limit = 100
period = 60

[[unsafe.bindings]]
name = "RATE_LIMITER_RPC"
type = "ratelimit"
limit = 1000
period = 60
",
}
`;

